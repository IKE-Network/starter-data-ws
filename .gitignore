# starter-data-ws .gitignore
# ═══════════════════════════
#
# Ignore everything; allowlist only working-set-owned files.
# Subproject repos are independent git repos cloned by ws:scaffold-init.

# ── Ignore everything by default ─────────────────────────────────
*

# ── Allowlist working-set-level files ────────────────────────────
!.gitignore
!pom.xml
!workspace.yaml
!README.adoc
!GOALS.md
!WS-REFERENCE.md
# Generated working-set guidance + hand-authored notes (ike-issues#790)
!CLAUDE.md
!CLAUDE-*.md
!mvnw
!mvnw.cmd
!versions-upgrade-rules.yaml

# ── Allowlist scaffold lockfile ──────────────────────────────────
!.ike/
!.ike/scaffold.lock

# ── Allowlist working-set-owned directories ──────────────────────
!.mvn/
!.mvn/**
!checkpoints/
!checkpoints/**
!.run/
!.run/**

# ── IntelliJ project config (curated slice) ──────────────────────
!.idea/
!.idea/.gitignore
!.idea/kotlinc.xml

# ws:* goal reports
ws꞉*.md
!.gitattributes

# ike:* goal reports
ike꞉*.md

# ws vcs bridge state (tool-written)
.ike/vcs-state
